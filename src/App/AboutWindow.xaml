<Window x:Class="Seamline.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="About Seamline"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image x:Name="LogoImage" Width="125" Height="125" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Grid.Column="1" Margin="18,0,0,0" MaxWidth="380">
            <TextBlock Text="Seamline" FontSize="27" FontWeight="Bold" Margin="0,-6,0,2" />
            <TextBlock x:Name="VersionText" FontSize="12" Margin="0,0,0,14"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="Align your physical multi-monitor setup with Windows' virtual screen layout — pixel by pixel." />
            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"
                       Text="Third-party components:&#10;.NET Runtime (MIT) — Microsoft&#10;CsWin32 (MIT) — Microsoft" />
            <Button Content="Close" MinWidth="96" MinHeight="32" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
