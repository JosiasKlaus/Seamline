<Window x:Class="Seamline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Seamline.App"
        x:ClassModifier="internal"
        Title="Seamline"
        Width="886"
        SizeToContent="Height"
        MinWidth="620"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <local:DisplayIndexConverter x:Key="DisplayIndex" />
        <local:MonitorTitleConverter x:Key="MonitorTitle" />
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <local:OrientationLineConverter x:Key="OrientationLine" />
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <!-- The overview absorbs all extra height; the other rows fit content. -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Explicit height only until the first layout: SizeToContent="Height"
             derives the launch height from it, then code-behind clears both so
             the star row takes over (see OnLoaded). -->
        <local:OverviewElement x:Name="Overview" Grid.Row="0" Height="220"
                               MinHeight="120" Margin="0,0,0,10" />

        <TextBlock x:Name="SectionLabel" Grid.Row="1" Text="Monitors"
                   FontSize="15" FontWeight="SemiBold" Margin="2,0,0,6"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <ItemsControl x:Name="Cards" Grid.Row="2" Margin="0,0,0,8" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:CardWrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,13,16,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="5" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TileFillBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DeviceName, Converter={StaticResource DisplayIndex}}"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,1,0,0"
                                           Text="{Binding Converter={StaticResource MonitorTitle}}"
                                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding MonitorName}" FontSize="12" Margin="0,0,0,4"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding FriendlyMonitorName, Converter={StaticResource EmptyToCollapsed}}" />
                            <TextBlock Text="{Binding DisplayAdapter}" FontSize="12" Margin="0,0,0,4"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,4"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}×{1}   ({2}, {3})">
                                        <Binding Path="ScreenWidth" />
                                        <Binding Path="ScreenHeight" />
                                        <Binding Path="PositionX" />
                                        <Binding Path="PositionY" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock FontSize="12" Margin="0,0,0,2" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource OrientationLine}">
                                        <Binding Path="Orientation" />
                                        <Binding Path="IsPrimary" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding DeviceName}" FontSize="10.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid x:Name="ButtonsRow" Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="About" MinWidth="96" MinHeight="32" Click="OnAboutClick" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="AdjustButton" Content="Adjust" MinWidth="96" MinHeight="32"
                        Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Close" MinWidth="96" MinHeight="32" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
