<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Core\Seamline.Core.csproj" />
    <ProjectReference Include="..\Win32\Seamline.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\seamline-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF removes System.IO from the SDK's implicit usings; the WinForms-era
         code (SettingsStore, resource loading) relies on it. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- M8: WPF-Fluent shell for the main window; the physical-pixel session
         overlays stay WinForms (see docs/ARCHITECTURE.md, DPI regimes). -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>seamline</AssemblyName>
    <ApplicationIcon>seamline.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Seamline</Product>
    <AssemblyTitle>Seamline</AssemblyTitle>
    <Company>Josias Klaus</Company>
    <Copyright>© 2026 Josias Klaus</Copyright>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 wants DPI config only via ApplicationHighDpiMode; we deliberately also
         declare it in app.manifest as the earliest, loader-level declaration and verify
         the effective context with a runtime assert. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>